SERVER_PORT=8080
PUBLIC_URL=http://localhost:3000
# Lumen's Docker Postgres listens on 5433 (5432 is used by another install on this Mac).
# stringtype=unspecified lets plain strings compare against the citext email column.
DB_URL=jdbc:postgresql://localhost:5433/learnai?stringtype=unspecified
DB_USERNAME=learnai
DB_PASSWORD=learnai-local
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_WS_URL=ws://localhost:8001
AI_SERVICE_TOKEN=change-me-same-as-ai-service-INTERNAL_TOKEN
STORAGE_DIR=../storage
MAX_UPLOAD_MB=25
USER_STORAGE_QUOTA_MB=500
SPRINGDOC_ENABLED=true
HARNESS_TURN_TTL_MINUTES=10
HARNESS_MAX_COMPLETION_KB=32
HARNESS_REMOTE_URL_ENABLED=false
FORCE_STRICT_PROFILE=false
PROVIDER_KEY_SECRET=change-me-32-bytes-base64
ADMIN_EMAILS=
